<Window x:Class="Семенов.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF" Height="200" Width="300">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Введите текст:" Margin="0,0,0,5"/>
            <TextBox x:Name="InputBox" Margin="0,0,0,10"/>
            <Button Content="Показать" Click="OnShowClick"/>
            <TextBlock x:Name="ResultLabel" Text="" Margin="0,10,0,0" FontWeight="Bold"/>
            <Button Content="Button"/>
        </StackPanel>
    </Grid>
</Window>

